#!name=出去走走 · 自动步数
#!desc=每天自动帮你把 Zepp 步数提交到「出去走走」, 不用再打开网页手动点. 分时段渐进提交, 晚上提交最终步数, 执行结果会发通知.
#!author=豆包
#!version=1.0.0

[Argument]
account = input,"",tag=账号 (邮箱/手机号),desc=你在出去走走网页里填的那个 Zepp 账号
password = input,"",tag=密码,desc=只保存在你手机的 Loon 里, 不会上传到任何地方
minStep = input,"18000",tag=最终步数下限,desc=每天最终步数在这个范围随机 (晚上那次生效)
maxStep = input,"30000",tag=最终步数上限,desc=建议不要超过 30000, 太假容易被盯上
gradual = switch,true,tag=分时段渐进,desc=开启后白天分几次慢慢涨 (更像真人走路); 关闭则每次都直接提交最终步数
enabled = switch,true,tag=启用自动提交,desc=总开关

[Script]
cron "0 8 * * *" script-path=https://raw.githubusercontent.com/saga0924/Loon/main/zouzou/zouzou.js,tag=出去走走·早,timeout=60,argument=[{account},{password},{minStep},{maxStep},{gradual}],enable={enabled}
cron "0 12 * * *" script-path=https://raw.githubusercontent.com/saga0924/Loon/main/zouzou/zouzou.js,tag=出去走走·午,timeout=60,argument=[{account},{password},{minStep},{maxStep},{gradual}],enable={enabled}
cron "0 16 * * *" script-path=https://raw.githubusercontent.com/saga0924/Loon/main/zouzou/zouzou.js,tag=出去走走·下午,timeout=60,argument=[{account},{password},{minStep},{maxStep},{gradual}],enable={enabled}
cron "0 20 * * *" script-path=https://raw.githubusercontent.com/saga0924/Loon/main/zouzou/zouzou.js,tag=出去走走·晚,timeout=60,argument=[{account},{password},{minStep},{maxStep},{gradual}],enable={enabled}
cron "30 22 * * *" script-path=https://raw.githubusercontent.com/saga0924/Loon/main/zouzou/zouzou.js,tag=出去走走·最终,timeout=60,argument=[{account},{password},{minStep},{maxStep},{gradual}],enable={enabled}
