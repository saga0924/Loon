#!name=QQ音乐每日任务
#!desc=绿钻成长值 + 金币中心签到、每日任务、定时金币、红包雨（脚本作者 MaYIHEI，插件在 Loon 内自动拉取作者最新版脚本）
#!author=MaYIHEI
#!homepage=https://github.com/MaYIHEI/paperclip
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/qqmusic.png

[Argument]
capture = switch,false,tag=抓取开关,desc=打开后，打开 QQ 音乐签到页会自动保存签到要用的 Cookie；抓完可以关掉

[Script]
http-request (?i)^https:\/\/u6\.y\.qq\.com\/cgi-bin\/musics\.fcg\?.*(EveryDaySignLvzScore|GetSignInSummary) script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/qqmusic/qqmusic.js, requires-body=true, tag=QQ音乐 Cookie, enable={capture}

cron "0 30 7 * * *" script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/qqmusic/qqmusic.js, tag=QQ音乐每日任务

cron "0 * 9-10 * * *" script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/qqmusic/qqmusic.js, tag=QQ音乐定时金币

cron "0 5 0,8,12,16,20,22 * * *" script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/qqmusic/qqmusic.js, tag=QQ音乐红包雨

[MITM]
hostname = u6.y.qq.com
