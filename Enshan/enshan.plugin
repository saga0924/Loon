#!name=恩山论坛 · 每日签到
#!icon=https://raw.githubusercontent.com/saga0924/Loon/main/Enshan/icon.png
#!desc=每天早上 8:00–10:00 之间随机时间自动签到领恩山币（遇 WAF 验证自动解算）。使用前先打开「抓取开关」，在 Safari 登录恩山并打开一次签到页抓取 Cookie，抓完关掉开关即可。Cookie 只保存在本机 Loon。（v1.3）
#!author=皮皮皮皮皮皮
#!version=1.3
#!homepage=https://www.right.com.cn/forum

[Argument]
capture = switch,false,tag=抓取开关,desc=打开后在 Safari 登录恩山并打开签到页即可抓取 Cookie，抓完请关闭
erronly = switch,false,tag=仅失败时通知,desc=打开后只有签到失败才弹通知，成功只记日志

[Script]
http-request ^https:\/\/www\.right\.com\.cn\/forum\/ script-path=https://raw.githubusercontent.com/saga0924/Loon/main/Enshan/enshan.js, requires-body=false, tag=恩山Cookie抓取, enable={capture}
cron "*/10 8-10 * * *" script-path=https://raw.githubusercontent.com/saga0924/Loon/main/Enshan/enshan.js, tag=恩山每日签到, argument="erronly={erronly}"

[Rule]
DOMAIN,www.right.com.cn,DIRECT

[MITM]
hostname = www.right.com.cn
